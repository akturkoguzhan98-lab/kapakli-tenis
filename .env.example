# Yerel geliştirme ayarları. Bu dosyayı ".env" ve ".dev.vars" adlarıyla kopyalayın.
# Canlı sitede bu değerler Cloudflare panelinden (Worker → Settings → Variables and Secrets) girilir.

# Oturum anahtarı: en az 32 karakter rastgele metin (canlıda "Secret" olarak ekleyin)
AUTH_SECRET="degistirin-bu-gelistirme-anahtaridir-0123456789"

# Sitenin adresi (karne bildirimindeki bağlantı için)
APP_URL="http://localhost:3000"

# --- İSTEĞE BAĞLI: otomatik WhatsApp gönderimi (Meta WhatsApp Business Cloud API, mesaj başına ücretli) ---
# Boş bırakılırsa ücretsiz "elle gönderim" modu çalışır.
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="kta_bilgilendirme"
WHATSAPP_TEMPLATE_LANG="tr"
CRON_SECRET=""
