{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapakli-tenis",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kapakli-tenis",
      // Cloudflare panelinde D1 veritabanını oluşturunca verilen kimlikle değiştirin
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sitenin adresi (karne bildirimi bağlantısı için). Alan adınızı bağlayınca güncelleyin.
    "APP_URL": "https://kapakli-tenis.workers.dev"
  },
  "observability": { "enabled": true }
}
