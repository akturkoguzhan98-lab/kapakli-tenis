{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapakli-tenis",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kapakli-tenis",
      // Cloudflare panelinde D1 veritabanını oluşturunca verilen kimlikle değiştirin
      "database_id": "bbc260fc-0c0e-4cc3-9d26-cc5f59371c63",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sitenin adresi (karne bildirimi bağlantısı için). Alan adınızı bağlayınca güncelleyin.
    "APP_URL": "https://kapakli-tenis.akturkoguzhan98.workers.dev"
  },
  "observability": { "enabled": true }
}
